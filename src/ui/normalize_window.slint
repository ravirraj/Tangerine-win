import { Tokens, Panel } from "tokens.slint";
import { Hairline, LabeledSlider, CardFooter } from "shell.slint";

export component NormalizeCard inherits Window {
    in property <float> ui-scale: 1.0;
    in property <length> card-width: 400px;
    in property <length> card-height: 611px;

    in property <Panel> header-box;
    in property <Panel> hairline-top;
    in property <Panel> file-info-box;
    in property <string> file-name: "Voice with pauses.wav";
    in property <string> duration-text: "0:02.00";

    in property <Panel> waveform-box;
    in property <image> waveform-strip;
    in property <float> playhead-fraction: 0.0;

    in property <Panel> transport-box;
    in property <bool> is-playing: false;
    in property <string> timecode-text: "0:00.00 / 0:02.00";

    in property <Panel> target-box;
    in property <float> target-lufs: -16.0;
    in property <string> target-text: "-16 LUFS";

    in property <Panel> range-box;
    in property <float> loudness-range: 11.0;
    in property <string> range-text: "11 LU";

    in property <Panel> peak-box;
    in property <float> true-peak: -1.5;
    in property <string> peak-text: "-1.5 dBTP";

    in property <Panel> footnote-box;
    in property <string> footnote-text: "-16 LUFS is a balanced default for spoken audio and music. The true peak limit helps prevent clipping after encoding.";

    in property <Panel> hairline-bottom;
    in property <Panel> helper-box;
    in property <Panel> cancel-box;
    in property <Panel> run-box;
    in property <string> run-label: "Normalize Audio";
    in property <bool> run-enabled: true;
    in property <int> button-focus: 0;
    in property <int> slider-focus: 0; // 1 = target, 2 = range, 3 = peak

    callback dismiss-chosen();
    callback play-chosen();
    callback target-changed(float);
    callback range-changed(float);
    callback peak-changed(float);
    callback run-chosen();
    callback cancel-chosen();

    width: root.card-width;
    height: root.card-height;
    background: Tokens.content;

    // 1. Header (dismiss circle on left, title centered)
    Rectangle {
        x: 16px * root.ui-scale;
        y: (root.header-box.height - self.height) / 2;
        width: 24px * root.ui-scale;
        height: 24px * root.ui-scale;
        border-radius: self.height / 2;
        background: dismiss-touch.pressed ? Tokens.quiet-pressed
                  : (dismiss-touch.has-hover ? Tokens.quiet-hover : Tokens.quiet);

        dismiss-touch := TouchArea {
            clicked => { root.dismiss-chosen(); }
        }

        Path {
            commands: "M 7 7 L 17 17 M 17 7 L 7 17";
            stroke: Tokens.text;
            stroke-width: 1.5px;
            stroke-line-cap: round;
            width: parent.width;
            height: parent.height;
        }
    }

    Text {
        x: root.header-box.x; y: root.header-box.y;
        width: root.header-box.width; height: root.header-box.height;
        text: "Normalize Volume";
        color: Tokens.text;
        font-size: root.ui-scale * 15px;
        font-weight: 600;
        font-family: "Segoe UI";
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    Hairline {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.hairline-top;
    }

    // 2. File Info Row (file name left, duration right)
    Rectangle {
        x: root.file-info-box.x;
        y: root.file-info-box.y;
        width: root.file-info-box.width;
        height: root.file-info-box.height;
        background: transparent;

        Text {
            x: 0;
            y: 0;
            width: parent.width - 80px * root.ui-scale;
            height: parent.height;
            text: root.file-name;
            font-size: 13px * root.ui-scale;
            font-weight: 500;
            font-family: "Segoe UI";
            color: Tokens.text;
            vertical-alignment: center;
            overflow: elide;
        }

        Text {
            x: parent.width - self.width;
            y: 0;
            height: parent.height;
            text: root.duration-text;
            font-size: 13px * root.ui-scale;
            font-weight: 400;
            font-family: "Segoe UI";
            color: Tokens.text;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    // 3. Waveform preview track
    Rectangle {
        x: root.waveform-box.x;
        y: root.waveform-box.y;
        width: root.waveform-box.width;
        height: root.waveform-box.height;
        border-radius: 8px * root.ui-scale;
        background: Tokens.elevated;
        clip: true;

        // Waveform strip image
        Image {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            source: root.waveform-strip;
            image-fit: fill;
        }

        // Scrub playhead line
        Rectangle {
            x: root.playhead-fraction * (parent.width - 2px * root.ui-scale);
            y: 0;
            width: 2px * root.ui-scale;
            height: parent.height;
            background: #FFFFFF;
            drop-shadow-color: #00000030;
            drop-shadow-offset-x: 1px;
            drop-shadow-blur: 2px;
        }
    }

    // 4. Transport Row (play button left, timecode right)
    Rectangle {
        x: root.transport-box.x;
        y: root.transport-box.y;
        width: root.transport-box.width;
        height: root.transport-box.height;
        background: transparent;

        // Play / Pause button
        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: 24px * root.ui-scale;
            height: 24px * root.ui-scale;
            border-radius: 4px * root.ui-scale;
            background: play-touch.pressed ? Tokens.quiet-pressed
                      : (play-touch.has-hover ? Tokens.quiet-hover : transparent);

            play-touch := TouchArea {
                clicked => { root.play-chosen(); }
            }

            Text {
                text: root.is-playing ? "⏸" : "▶";
                font-size: 12px * root.ui-scale;
                font-family: "Segoe UI";
                color: Tokens.text;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        // Timecode readout on right
        Text {
            x: parent.width - self.width;
            y: 0;
            height: parent.height;
            text: root.timecode-text;
            font-size: 13px * root.ui-scale;
            font-family: "Segoe UI";
            color: Tokens.text;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }

    // 5. Target Loudness Slider (-30..-8 LUFS)
    LabeledSlider {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        ui-scale: root.ui-scale;
        box: root.target-box;
        label: "Target loudness";
        value-text: root.target-text;
        min: -30.0;
        max: -8.0;
        value: root.target-lufs;
        ticks: [0.0, 0.05, 0.10, 0.15, 0.20, 0.25, 0.30, 0.35, 0.40, 0.45, 0.50, 0.55, 0.60, 0.65, 0.70, 0.75, 0.80, 0.85, 0.90, 0.95, 1.0];
        focused: root.slider-focus == 1;
        value-changed(val) => { root.target-changed(val); }
    }

    // 6. Loudness Range Slider (1..20 LU)
    LabeledSlider {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        ui-scale: root.ui-scale;
        box: root.range-box;
        label: "Loudness range";
        value-text: root.range-text;
        min: 1.0;
        max: 20.0;
        value: root.loudness-range;
        ticks: [0.0, 0.0526, 0.1053, 0.1579, 0.2105, 0.2632, 0.3158, 0.3684, 0.4211, 0.4737, 0.5263, 0.5789, 0.6316, 0.6842, 0.7368, 0.7895, 0.8421, 0.8947, 0.9474, 1.0];
        focused: root.slider-focus == 2;
        value-changed(val) => { root.range-changed(val); }
    }

    // 7. True Peak Limit Slider (-9..0 dBTP)
    LabeledSlider {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        ui-scale: root.ui-scale;
        box: root.peak-box;
        label: "True peak limit";
        value-text: root.peak-text;
        min: -9.0;
        max: 0.0;
        value: root.true-peak;
        ticks: [0.0, 0.0556, 0.1111, 0.1667, 0.2222, 0.2778, 0.3333, 0.3889, 0.4444, 0.50, 0.5556, 0.6111, 0.6667, 0.7222, 0.7778, 0.8333, 0.8889, 0.9444, 1.0];
        focused: root.slider-focus == 3;
        value-changed(val) => { root.peak-changed(val); }
    }

    // 8. Footnote description
    Text {
        x: root.footnote-box.x;
        y: root.footnote-box.y;
        width: root.footnote-box.width;
        height: root.footnote-box.height;
        text: root.footnote-text;
        font-size: 12px * root.ui-scale;
        font-family: "Segoe UI";
        color: Tokens.text-muted;
        wrap: word-wrap;
    }

    // 9. Hairline Bottom & Footer
    Hairline {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.hairline-bottom;
    }

    CardFooter {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        ui-scale: root.ui-scale;
        run-label: root.run-label;
        has-cancel: false;
        run-enabled: root.run-enabled;
        helper-box: root.helper-box;
        cancel-box: root.cancel-box;
        run-box: root.run-box;
        button-focus: root.button-focus;
        run-chosen => { root.run-chosen(); }
        cancel-chosen => { root.cancel-chosen(); }
    }
}
