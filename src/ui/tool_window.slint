// The card a tool is asked on.
//
// The skeleton — header, hairlines, footer — is the shell's, shared by
// every tool window (shell.slint); this file says only this card's body:
// the file's own picture, edge to edge, and the tiles a size is typed in.
// The geometry is worked out in Rust, where the fields the person types
// into are placed by the same numbers: the card only draws what it is
// told, where it is told.

import { Tokens } from "tokens.slint";
import { Panel } from "tokens.slint";
import { CardHeader, Hairline, FieldTile, CardFooter } from "shell.slint";

export { Panel } from "tokens.slint";
// A file may re-export with `*` only once, so the other windows hang off
// this one in a chain: wheel.slint -> here -> trim_window.slint -> ...
// The order says nothing about the code; it is only how the one compiled
// entry gathers every window. The crop window is hung on with its name,
// for the one star of a chain is already spent here.
export * from "trim_window.slint";
export { CropCard } from "crop_window.slint";
export { CompressCard } from "compress_window.slint";
export { MetadataCard } from "metadata_window.slint";
export { NormalizeCard } from "normalize_window.slint";
export { ChannelsCard } from "channels_window.slint";
export { RedactImageCard } from "redact_image_window.slint";
export { RedactVideoCard } from "redact_video_window.slint";
export { RedactAudioCard } from "redact_audio_window.slint";
export { SpeedCard } from "speed_window.slint";
export { MergeCard, MergeItemData } from "merge_window.slint";
export { OrganizePdfCard, PageCardData } from "organize_pdf_window.slint";
export { FrameImageCard } from "frame_image_window.slint";

export component ToolCard inherits Window {
    // The size of the card, held here so the renderer reads what the
    // window really is: the system tells us the client size, and the
    // renderer draws exactly what these two say.
    in property <length> card-width: 460px;
    in property <length> card-height: 560px;

    // What the card says.
    in property <string> file-name;
    in property <string> detail;
    in property <image> preview;
    in property <bool> has-preview;
    in property <bool> wants-size;
    // How much the display stretches everything: the words grow with it.
    in property <float> ui-scale: 1.0;

    // Where everything is.
    in property <Panel> header-box;
    in property <Panel> detail-box;
    in property <Panel> hairline-top;
    in property <Panel> hairline-bottom;
    in property <Panel> preview-box;
    in property <Panel> width-tile;
    in property <Panel> height-tile;
    in property <Panel> helper-box;
    in property <Panel> cancel-box;
    in property <Panel> run-box;

    // What is being written in, and what the keyboard is on.
    in property <bool> width-focused;
    in property <bool> height-focused;
    // 0 nothing, 1 cancel, 2 run.
    in property <int> button-focus;

    callback run-chosen();
    callback cancel-chosen();

    width: root.card-width;
    height: root.card-height;

    Rectangle {
        background: Tokens.window-bg;
    }

    CardHeader {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        file-name: root.file-name;
        detail: root.detail;
        ui-scale: root.ui-scale;
        header-box: root.header-box;
        detail-box: root.detail-box;
    }
    Hairline {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.hairline-top;
    }

    // The body: the file's own picture, filling its whole card.
    Rectangle {
        x: root.preview-box.x; y: root.preview-box.y;
        width: root.preview-box.width; height: root.preview-box.height;
        border-radius: Tokens.radius-preview;
        background: Tokens.elevated;
        clip: true;

        if root.has-preview: Image {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            source: root.preview;
            image-fit: contain;
        }
    }

    if root.wants-size: FieldTile {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.width-tile;
        label: "Width";
        focused: root.width-focused;
        ui-scale: root.ui-scale;
    }
    if root.wants-size: FieldTile {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.height-tile;
        label: "Height";
        focused: root.height-focused;
        ui-scale: root.ui-scale;
    }

    Hairline {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.hairline-bottom;
    }

    CardFooter {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        ui-scale: root.ui-scale;
        helper-box: root.helper-box;
        cancel-box: root.cancel-box;
        run-box: root.run-box;
        button-focus: root.button-focus;
        run-chosen => { root.run-chosen(); }
        cancel-chosen => { root.cancel-chosen(); }
    }
}
