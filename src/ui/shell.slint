// The skeleton every tool window wears, and the first of the shared
// controls.
//
// A tool window is the same card every time — a header of the file's name
// and the tool's words, a hairline, whatever the tool asks of the body,
// another hairline, and a footer whose left says the shortcuts and whose
// right says go. The parts of that skeleton live here, once, so the
// twenty-one windows the reference product shows feel like one product
// wearing our skin: each window's file says only its body.
//
// The buttons are quiet pills, the way the reference draws them; the
// orange is the colour of what is chosen, not of what is pressed.

import { Tokens } from "tokens.slint";
import { Panel } from "tokens.slint";

// The header: the file this is about, and what the tool does. (The
// tool's own name stands in the window's title bar, which on Windows is
// the system's; the original's centred title lives there.)
export component CardHeader {
    in property <string> file-name;
    in property <string> detail;
    in property <float> ui-scale: 1.0;
    in property <Panel> header-box;
    in property <Panel> detail-box;

    Text {
        x: root.header-box.x; y: root.header-box.y;
        width: root.header-box.width; height: root.header-box.height;
        text: root.file-name;
        color: Tokens.text;
        font-size: root.ui-scale * 15px;
        font-weight: 600;
        font-family: "Segoe UI";
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: root.detail-box.x; y: root.detail-box.y;
        width: root.detail-box.width; height: root.detail-box.height;
        text: root.detail;
        color: Tokens.text-muted;
        font-size: root.ui-scale * 13px;
        font-family: "Segoe UI";
        vertical-alignment: center;
        overflow: elide;
    }
}

// A hairline, full width, holding the card together.
export component Hairline {
    in property <Panel> box;

    Rectangle {
        x: root.box.x; y: root.box.y;
        width: root.box.width; height: 1px;
        background: Tokens.hairline;
    }
}

// A field a size is typed into. The field itself is white with a thin
// border, and the keyboard's arrival turns its border the orange.
export component FieldTile {
    in property <string> label: "Width";
    in property <bool> focused: false;
    in property <float> ui-scale: 1.0;
    in property <Panel> box;

    Rectangle {
        x: root.box.x; y: root.box.y;
        width: root.box.width; height: root.box.height;
        border-radius: Tokens.radius-control;
        background: Tokens.content;
        border-width: 1px;
        border-color: root.focused ? Tokens.accent : Tokens.field-border;

        Text {
            x: 10px; width: 44px; height: parent.height;
            text: root.label;
            color: Tokens.text-muted;
            font-size: root.ui-scale * 13px;
            font-family: "Segoe UI";
            vertical-alignment: center;
        }
        Text {
            x: parent.width - 28px; width: 20px; height: parent.height;
            text: "px";
            color: Tokens.text-muted;
            font-size: root.ui-scale * 13px;
            font-family: "Segoe UI";
            vertical-alignment: center;
        }
    }
}

// A bare transport glyph with a generous hit area: the skip and step
// icons under a timeline are line drawings, not buttons.
export component IconButton {
    in property <string> glyph;
    in property <bool> focused: false;
    in property <float> ui-scale: 1.0;
    in property <Panel> box;

    callback clicked();

    // The ring the keyboard puts around the glyph.
    Rectangle {
        x: root.box.x - 3px; y: root.box.y - 3px;
        width: root.box.width + 6px; height: root.box.height + 6px;
        border-radius: root.box.height / 2 + 3px;
        border-width: 2px;
        border-color: Tokens.accent;
        visible: root.focused;
    }
    Rectangle {
        x: root.box.x; y: root.box.y;
        width: root.box.width; height: root.box.height;
        border-radius: root.box.height / 2;
        background: icon-touch.pressed ? Tokens.quiet-pressed
                   : (icon-touch.has-hover ? Tokens.quiet-hover : transparent);

        icon-touch := TouchArea {
            clicked => { root.clicked(); }
        }

        Path {
            commands: root.glyph;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: Tokens.transport;
            stroke-width: 1.8px;
            stroke-line-cap: round;
            stroke-line-join: round;
            width: root.ui-scale * 18px;
            height: root.ui-scale * 18px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

// The quiet pill a card's body rows take for their small actions: the
// same face the footer's buttons wear, one pressable with words on it.
// What is chosen is orange; a pill is only an action, so it stays quiet
// until the pointer or the keyboard is on it.
export component PillButton {
    in property <Panel> box;
    in property <string> label;
    in property <bool> focused: false;
    in property <float> ui-scale: 1.0;

    callback clicked();

    // The ring the keyboard puts around the pill.
    Rectangle {
        x: root.box.x - 3px; y: root.box.y - 3px;
        width: root.box.width + 6px; height: root.box.height + 6px;
        border-radius: Tokens.radius-control + 3px;
        border-width: 2px;
        border-color: Tokens.accent;
        visible: root.focused;
    }
    Rectangle {
        x: root.box.x; y: root.box.y;
        width: root.box.width; height: root.box.height;
        border-radius: Tokens.radius-control;
        background: pill-touch.pressed ? Tokens.quiet-pressed
                   : (pill-touch.has-hover ? Tokens.quiet-hover : Tokens.quiet);

        pill-touch := TouchArea {
            clicked => { root.clicked(); }
        }

        Text {
            x: 8px; width: parent.width - 16px;
            height: parent.height;
            text: root.label;
            color: Tokens.text;
            font-size: root.ui-scale * 13px;
            font-family: "Segoe UI";
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// The range a timeline holds: the strip, the chosen stretch framed by
// two solid orange caps — each with a white grip to take hold of — and
// the thin white playhead standing on the moment. The trim window wears
// it now; split and trim-audio wear it after.
//
// 0 no handle is under the keyboard, 1 the start cap, 2 the end cap.
export component TimelineRange {
    in property <Panel> box;
    // The video's own moments, side by side: the strip the reference
    // runs its range over. Empty, the strip is a plain well.
    in property <image> filmstrip;
    in property <float> start-fraction: 0;
    in property <float> end-fraction: 1;
    in property <float> playhead-fraction: 0;
    in property <int> handle-focus: 0;
    // Whether a stretch is dragged at all: a split stands on markers, not
    // on a range, so its window says no and the caps stay away.
    in property <bool> has-range: true;
    // Where the cuts stand, from 0 to 1 of the whole. A split card says
    // them; a trim card says none.
    in property <[float]> markers;

    Rectangle {
        x: root.box.x; y: root.box.y;
        width: root.box.width; height: root.box.height;
        border-radius: Tokens.radius-control;
        background: Tokens.elevated;
        clip: true;

        // The video's own moments, one strip of them.
        Image {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            source: root.filmstrip;
            image-fit: ImageFit.fill;
        }

        // Outside the chosen stretch the strip sits back; inside it the
        // strip is clear: the cut-away is darkened, the way the
        // reference withdraws what is not kept. A split has no stretch
        // of its own, and shows the whole of the strip.
        Rectangle {
            x: 0; y: 0;
            width: root.start-fraction * parent.width;
            height: parent.height;
            background: #1A1A1A8C;
            visible: root.has-range;
        }
        Rectangle {
            x: root.end-fraction * parent.width; y: 0;
            width: (1 - root.end-fraction) * parent.width;
            height: parent.height;
            background: #1A1A1A8C;
            visible: root.has-range;
        }

        // The end caps: solid orange columns the full height of the
        // strip, each carrying a white grip to take hold of. Drawn to
        // stand out past the strip's own corners, so at the rim they are
        // cut to its rounding. At the very ends they stand inside, flush
        // with the strip's rim.
        Rectangle {
            x: root.start-fraction * parent.width - 14px > 0px
                    ? root.start-fraction * parent.width - 14px : 0px;
            y: 0;
            width: 28px;
            height: parent.height;
            border-radius: 10px;
            background: root.handle-focus == 1 ? Tokens.accent-pressed : Tokens.accent;
            visible: root.has-range;

            Rectangle {
                width: 4px;
                height: parent.height / 3;
                background: Tokens.content;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        Rectangle {
            x: root.end-fraction * parent.width + 14px < parent.width
                    ? root.end-fraction * parent.width - 14px : parent.width - 28px;
            y: 0;
            width: 28px;
            height: parent.height;
            border-radius: 10px;
            background: root.handle-focus == 2 ? Tokens.accent-pressed : Tokens.accent;
            visible: root.has-range;

            Rectangle {
                width: 4px;
                height: parent.height / 3;
                background: Tokens.content;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // The places a split cuts, said in the colour of choosing: a thin
        // column of orange standing on each one. The playhead is drawn
        // after, so where a cut and the playhead agree, the playhead
        // stands over it.
        for marker in root.markers: Rectangle {
            x: marker * parent.width - 1px;
            y: 0;
            width: 2px;
            height: parent.height;
            background: Tokens.accent;
        }

        // The playhead: a thin white line standing on the moment.
        Rectangle {
            x: root.playhead-fraction * parent.width - 1px;
            y: 0;
            width: 2px;
            height: parent.height;
            background: Tokens.content;
        }
    }
}

// The footer: the shortcuts on the left, go on the right. A no button
// stands beside the go only where the tool wants one — the reference
// keeps a single action, and Escape says no on every card either way.
//
// 0 nothing is under the keyboard, 1 cancel, 2 run.
export component CardFooter {
    in property <float> ui-scale: 1.0;
    in property <string> helper: "Enter to run \u{b7} Esc to close";
    in property <string> run-label: "Run";
    in property <bool> has-cancel: true;
    // A go button with nothing to do is said no, its words retired and
    // its press taken away until the card has something to do.
    in property <bool> run-enabled: true;
    in property <Panel> helper-box;
    in property <Panel> cancel-box;
    in property <Panel> run-box;
    in property <int> button-focus;

    callback run-chosen();
    callback cancel-chosen();

    Text {
        x: root.helper-box.x; y: root.helper-box.y;
        width: root.helper-box.width; height: root.helper-box.height;
        text: root.helper;
        color: Tokens.text-muted;
        font-size: root.ui-scale * 13px;
        font-family: "Segoe UI";
        vertical-alignment: center;
        overflow: elide;
    }

    // The ring the keyboard puts around whichever button it is on.
    Rectangle {
        x: root.cancel-box.x - 3px; y: root.cancel-box.y - 3px;
        width: root.cancel-box.width + 6px; height: root.cancel-box.height + 6px;
        border-radius: Tokens.radius-control + 3px;
        border-width: 2px;
        border-color: Tokens.accent;
        visible: root.has-cancel && root.button-focus == 1;
    }
    Rectangle {
        x: root.run-box.x - 3px; y: root.run-box.y - 3px;
        width: root.run-box.width + 6px; height: root.run-box.height + 6px;
        border-radius: Tokens.radius-control + 3px;
        border-width: 2px;
        border-color: Tokens.accent;
        visible: root.button-focus == 2;
    }
    if root.has-cancel: Rectangle {
        x: root.cancel-box.x; y: root.cancel-box.y;
        width: root.cancel-box.width; height: root.cancel-box.height;
        border-radius: Tokens.radius-control;
        background: cancel-touch.pressed ? Tokens.quiet-pressed
                   : (cancel-touch.has-hover ? Tokens.quiet-hover : Tokens.quiet);

        cancel-touch := TouchArea {
            clicked => { root.cancel-chosen(); }
        }

        Text {
            text: "Cancel";
            color: Tokens.text;
            font-size: root.ui-scale * 13px;
            font-family: "Segoe UI";
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    Rectangle {
        x: root.run-box.x; y: root.run-box.y;
        width: root.run-box.width; height: root.run-box.height;
        border-radius: Tokens.radius-control;
        background: !root.run-enabled ? Tokens.quiet
                   : (run-touch.pressed ? Tokens.quiet-pressed
                   : (run-touch.has-hover ? Tokens.quiet-hover : Tokens.quiet));

        run-touch := TouchArea {
            enabled: root.run-enabled;
            clicked => { root.run-chosen(); }
        }

        Text {
            text: root.run-label;
            color: root.run-enabled ? Tokens.text : Tokens.text-muted;
            font-size: root.ui-scale * 13px;
            font-weight: 500;
            font-family: "Segoe UI";
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A round checkbox: the toggle compress.webp and removeMetadata.webp show.
// What is checked is filled with the orange accent, carrying a white checkmark;
// unchecked is quiet with a subtle border.
export component RoundCheckbox {
    in property <Panel> box;
    in property <string> label;
    in property <bool> checked: false;
    in property <bool> focused: false;
    in property <float> ui-scale: 1.0;

    callback toggled();

    // The ring the keyboard puts around the checkbox.
    Rectangle {
        x: root.box.x - 3px; y: root.box.y - 3px;
        width: root.box.width + 6px; height: root.box.height + 6px;
        border-radius: root.box.height / 2 + 3px;
        border-width: 2px;
        border-color: Tokens.accent;
        visible: root.focused;
    }

    Rectangle {
        x: root.box.x; y: root.box.y;
        width: root.box.width; height: root.box.height;
        background: transparent;

        TouchArea {
            clicked => { root.toggled(); }
        }

        // The circle itself
        Rectangle {
            x: 0;
            y: (parent.height - self.height) / 2;
            width: root.ui-scale * 18px;
            height: root.ui-scale * 18px;
            border-radius: self.height / 2;
            background: root.checked ? Tokens.accent : Tokens.content;
            border-width: root.checked ? 0px : 1px;
            border-color: root.checked ? Tokens.accent : Tokens.field-border;

            // Checkmark glyph inside circle when checked
            Path {
                visible: root.checked;
                commands: "M 4 9 L 7.5 12.5 L 14 5";
                viewbox-width: 18;
                viewbox-height: 18;
                fill: transparent;
                stroke: Tokens.content;
                stroke-width: 2px;
                stroke-line-cap: round;
                stroke-line-join: round;
                width: parent.width;
                height: parent.height;
            }
        }

        // The label text beside the circle
        Text {
            x: root.ui-scale * 26px;
            y: 0;
            width: parent.width - self.x;
            height: parent.height;
            text: root.label;
            color: Tokens.text;
            font-size: root.ui-scale * 13px;
            font-family: "Segoe UI";
            vertical-alignment: center;
        }
    }
}

