// The radial wheel.
//
// Every position, size and colour is worked out in Rust and handed over here
// as plain values. The software renderer that draws the overlay does not
// support element transforms, so the entrance animation scales the geometry
// itself instead of scaling an element.
//
// This file is the one the compiler is asked for, and it also gathers the
// card a tool is asked on: the one generated module the program includes
// holds every shape there is.

export * from "tool_window.slint";

export struct SegmentData {
    // The outline of the segment, in disc coordinates.
    path: string,
    fill: color,
    stroke: color,
    // The name of the choice.
    label: string,
    label-color: color,
    label-size: length,
    label-x: length,
    label-y: length,
    label-width: length,
    // The picture of the choice, drawn in a 24 by 24 box.
    icon: string,
    icon-color: color,
    icon-x: length,
    icon-y: length,
    icon-size: length,
}

export component Wheel inherits Window {
    in property <[SegmentData]> segments;
    // The heading in the hub. It is not called `title`, because the window
    // already has one of those.
    in property <string> heading: "";
    in property <string> subtitle: "";
    in property <string> badge: "";
    in property <int> mode-index: 0;
    in property <float> appear: 1;
    in property <float> disc-size: 380;
    in property <float> hub-size: 95;
    in property <length> heading-size: 12px;
    in property <length> subtitle-size: 10px;
    in property <bool> has-thumbnail: false;
    in property <image> file-thumbnail;
    // The segment that is being pointed at, and the one that is on its way out.
    in property <string> emphasis-path: "";
    in property <float> emphasis: 0;
    in property <string> fading-path: "";
    in property <float> fading: 0;

    // The colours come from the theme, so that the wheel is drawn the same
    // way in a light appearance and in a dark one.
    in property <color> disc-color: #00000000;
    in property <color> hub-color: #131317f2;
    in property <color> border-color: #2e2e36;
    in property <color> text-color: #f2f2f5;
    in property <color> text-secondary-color: #8a8a95;
    in property <color> emphasis-color: #ff8a3d4d;
    in property <color> emphasis-border: #ff8a3d;
    in property <color> fading-color: #ff8a3d1f;
    in property <color> fading-border: #ff8a3d80;

    // The short message about what came of the last operation. It is drawn
    // on its own, so that it can be shown after the wheel has gone.
    in property <string> notice-text: "";
    in property <bool> notice-failed: false;
    in property <float> notice-appear: 0;

    background: #00000000;

    Rectangle {
        width: root.disc-size * 1px;
        height: root.disc-size * 1px;
        opacity: root.appear;

        // The wheel itself: the circle the choices sit on.
        Rectangle {
            x: 0px;
            y: 0px;
            width: root.disc-size * 1px;
            height: root.disc-size * 1px;
            border-radius: root.disc-size / 2 * 1px;
            background: root.disc-color;
        }

        // The segments themselves.
        for seg in root.segments : Path {
            commands: seg.path;
            viewbox-x: -root.disc-size / 2;
            viewbox-y: -root.disc-size / 2;
            viewbox-width: root.disc-size;
            viewbox-height: root.disc-size;
            fill: seg.fill;
            stroke: seg.stroke;
            stroke-width: 1px;
            x: 0px;
            y: 0px;
            width: root.disc-size * 1px;
            height: root.disc-size * 1px;
        }

        // The segment under the pointer, lifting to meet it.
        Path {
            commands: root.emphasis-path;
            viewbox-x: -root.disc-size / 2;
            viewbox-y: -root.disc-size / 2;
            viewbox-width: root.disc-size;
            viewbox-height: root.disc-size;
            fill: root.emphasis-color;
            stroke: root.emphasis-border;
            stroke-width: 2px;
            opacity: root.emphasis;
            x: 0px;
            y: 0px;
            width: root.disc-size * 1px;
            height: root.disc-size * 1px;
        }

        // The segment that is losing the pointer.
        Path {
            commands: root.fading-path;
            viewbox-x: -root.disc-size / 2;
            viewbox-y: -root.disc-size / 2;
            viewbox-width: root.disc-size;
            viewbox-height: root.disc-size;
            fill: root.fading-color;
            stroke: root.fading-border;
            stroke-width: 1px;
            opacity: root.fading;
            x: 0px;
            y: 0px;
            width: root.disc-size * 1px;
            height: root.disc-size * 1px;
        }

        // The picture of each choice.
        for seg in root.segments : Path {
            commands: seg.icon;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: seg.icon-color;
            stroke-width: 1.8px;
            stroke-line-cap: round;
            stroke-line-join: round;
            x: seg.icon-x;
            y: seg.icon-y;
            width: seg.icon-size;
            height: seg.icon-size;
        }

        // The name of each choice.
        for seg in root.segments : Text {
            text: seg.label;
            color: seg.label-color;
            font-size: seg.label-size;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            x: seg.label-x - seg.label-width / 2;
            y: seg.label-y - 9px;
            width: seg.label-width;
            height: 18px;
        }

        // The hub in the middle.
        Rectangle {
            x: (root.disc-size - root.hub-size) / 2 * 1px;
            y: (root.disc-size - root.hub-size) / 2 * 1px;
            width: root.hub-size * 1px;
            height: root.hub-size * 1px;
            border-radius: root.hub-size / 2 * 1px;
            background: root.hub-color;
            border-width: 1px;
            border-color: root.border-color;

            if root.has-thumbnail : Rectangle {
                x: (root.hub-size * 1px - 34px) / 2;
                y: (root.hub-size / 2 - 38) * 1px;
                width: 34px;
                height: 34px;
                border-radius: 6px;
                clip: true;
                border-width: 1px;
                border-color: root.border-color;
                background: root.disc-color;

                Image {
                    width: 100%;
                    height: 100%;
                    source: root.file-thumbnail;
                }
            }

            Text {
                text: root.heading;
                color: root.text-color;
                font-size: root.has-thumbnail ? 11px : root.heading-size;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 0px;
                y: root.has-thumbnail ? (root.hub-size / 2 + 1) * 1px : (root.hub-size / 2 - 27) * 1px;
                width: root.hub-size * 1px;
                height: root.has-thumbnail ? 15px : 18px;
            }

            Text {
                visible: !root.has-thumbnail;
                text: root.subtitle;
                color: root.text-secondary-color;
                font-size: root.subtitle-size;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 0px;
                y: (root.hub-size / 2 - 8) * 1px;
                width: root.hub-size * 1px;
                height: 16px;
            }

            // Which of the three wheels is showing.
            for i in [0, 1, 2] : Rectangle {
                x: (root.hub-size / 2 - 24 + i * 16 + (i == root.mode-index ? 0 : 5)) * 1px;
                y: (root.hub-size / 2 + 20) * 1px;
                width: i == root.mode-index ? 16px : 6px;
                height: 5px;
                border-radius: 3px;
                background: i == root.mode-index ? #ff8a3d : root.text-secondary-color;
                opacity: i == root.mode-index ? 1.0 : 0.35;
            }
        }

        // The development marker, so a test wheel is never mistaken for a real
        // one.
        Rectangle {
            visible: root.badge != "";
            x: (root.disc-size / 2 - 65) * 1px;
            y: 8px;
            width: 130px;
            height: 20px;
            border-radius: 10px;
            background: #ff8a3d1f;
            border-width: 1px;
            border-color: #ff8a3d59;

            Text {
                text: root.badge;
                color: #ffb27a;
                font-size: 9px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                x: 0px;
                y: 0px;
                width: 130px;
                height: 20px;
            }
        }
    }

    // The message about what came of the last operation. It sits below the
    // wheel, so that it can be shown on its own once the wheel has gone.
    Rectangle {
        visible: root.notice-appear > 0;
        opacity: root.notice-appear;
        x: (root.disc-size - root.disc-size * 0.78) / 2 * 1px;
        y: (root.disc-size - root.disc-size * 0.1) * 1px;
        width: root.disc-size * 0.78 * 1px;
        height: root.disc-size * 0.08 * 1px;
        border-radius: root.disc-size * 0.04 * 1px;
        background: root.notice-failed ? #ff2a1f24 : #ff1a2a1f;
        border-width: 1px;
        border-color: root.notice-failed ? #ff6b3038 : #ff2f6b3a;

        Text {
            text: root.notice-text;
            color: root.notice-failed ? #ffb9a1a4 : #ffa1c9a6;
            font-size: root.disc-size * 0.03 * 1px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            x: 0px;
            y: 0px;
            width: root.disc-size * 0.78 * 1px;
            height: root.disc-size * 0.08 * 1px;
        }
    }
}
