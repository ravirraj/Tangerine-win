import { Tokens, Panel } from "tokens.slint";
import { CardHeader, Hairline } from "shell.slint";

export component EditImageCard inherits Window {
    in property <float> ui-scale: 1.0;
    in property <length> card-width: 440px;
    in property <length> card-height: 680px;

    in property <Panel> header-box;
    in property <Panel> detail-box;
    in property <Panel> hairline-top;
    in property <string> file-name: "photo.jpg";
    in property <string> detail: "Adjust photo";

    // Stage preview
    in property <Panel> stage-box;
    in property <image> preview-image;
    in property <bool> has-preview: false;
    in-out property <bool> show-original: false;

    // Sliders
    // 1. Exposure
    in property <Panel> exposure-label-box;
    in property <Panel> exposure-track-box;
    in property <Panel> exposure-thumb-box;
    in property <string> exposure-text: "0.0 EV";

    // 2. Brightness
    in property <Panel> brightness-label-box;
    in property <Panel> brightness-track-box;
    in property <Panel> brightness-thumb-box;
    in property <string> brightness-text: "0.0";

    // 3. Contrast
    in property <Panel> contrast-label-box;
    in property <Panel> contrast-track-box;
    in property <Panel> contrast-thumb-box;
    in property <string> contrast-text: "1.0x";

    // 4. Saturation
    in property <Panel> saturation-label-box;
    in property <Panel> saturation-track-box;
    in property <Panel> saturation-thumb-box;
    in property <string> saturation-text: "1.0x";

    // 5. Warmth
    in property <Panel> warmth-label-box;
    in property <Panel> warmth-track-box;
    in property <Panel> warmth-thumb-box;
    in property <string> warmth-text: "0";

    // 6. Vignette
    in property <Panel> vignette-label-box;
    in property <Panel> vignette-track-box;
    in property <Panel> vignette-thumb-box;
    in property <string> vignette-text: "0%";

    // Compare button
    in property <Panel> compare-box;

    // Footer
    in property <Panel> hairline-bottom;
    in property <Panel> reset-box;
    in property <Panel> helper-box;
    in property <Panel> cancel-box;
    in property <Panel> run-box;
    in property <string> run-label: "Save Adjusted";
    in property <bool> run-enabled: true;

    callback dismiss-chosen();
    callback compare-pressed(bool);
    callback reset-defaults-chosen();
    callback run-chosen();
    callback cancel-chosen();

    width: root.card-width;
    height: root.card-height;
    background: Tokens.window-bg;

    // 1. Header
    CardHeader {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        file-name: root.file-name;
        detail: root.detail;
        ui-scale: root.ui-scale;
        header-box: root.header-box;
        detail-box: root.detail-box;
    }

    Hairline {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.hairline-top;
    }

    // 2. Stage Preview (contained stage with letterbox)
    Rectangle {
        x: root.stage-box.x;
        y: root.stage-box.y;
        width: root.stage-box.width;
        height: root.stage-box.height;
        border-radius: Tokens.radius-preview;
        background: Tokens.preview-black;
        clip: true;

        if root.has-preview : Image {
            width: 100%;
            height: 100%;
            image-fit: contain;
            source: root.preview-image;
        }

        if !root.has-preview : Text {
            text: "Loading photo…";
            color: Tokens.text-muted;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // Hold to compare badge button
        Rectangle {
            x: parent.width - 120px;
            y: parent.height - 32px;
            width: 110px;
            height: 24px;
            border-radius: 12px;
            background: root.show-original ? Tokens.accent : #000000A0;

            Text {
                text: root.show-original ? "Original" : "Hold to compare";
                color: Tokens.content;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down {
                        root.show-original = true;
                        root.compare-pressed(true);
                    } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        root.show-original = false;
                        root.compare-pressed(false);
                    }
                }
            }
        }
    }

    // 3. Slider 1: Exposure
    Text {
        x: root.exposure-label-box.x;
        y: root.exposure-label-box.y;
        width: root.exposure-label-box.width;
        height: root.exposure-label-box.height;
        text: "Exposure: " + root.exposure-text;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.text;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.exposure-track-box.x;
        y: root.exposure-track-box.y;
        width: root.exposure-track-box.width;
        height: root.exposure-track-box.height;
        border-radius: 2px;
        background: Tokens.elevated;
    }

    Rectangle {
        x: root.exposure-thumb-box.x;
        y: root.exposure-thumb-box.y;
        width: root.exposure-thumb-box.width;
        height: root.exposure-thumb-box.height;
        border-radius: root.exposure-thumb-box.width / 2;
        background: Tokens.content;
        border-width: 1px;
        border-color: #00000030;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
    }

    // 4. Slider 2: Brightness
    Text {
        x: root.brightness-label-box.x;
        y: root.brightness-label-box.y;
        width: root.brightness-label-box.width;
        height: root.brightness-label-box.height;
        text: "Brightness: " + root.brightness-text;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.text;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.brightness-track-box.x;
        y: root.brightness-track-box.y;
        width: root.brightness-track-box.width;
        height: root.brightness-track-box.height;
        border-radius: 2px;
        background: Tokens.elevated;
    }

    Rectangle {
        x: root.brightness-thumb-box.x;
        y: root.brightness-thumb-box.y;
        width: root.brightness-thumb-box.width;
        height: root.brightness-thumb-box.height;
        border-radius: root.brightness-thumb-box.width / 2;
        background: Tokens.content;
        border-width: 1px;
        border-color: #00000030;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
    }

    // 5. Slider 3: Contrast
    Text {
        x: root.contrast-label-box.x;
        y: root.contrast-label-box.y;
        width: root.contrast-label-box.width;
        height: root.contrast-label-box.height;
        text: "Contrast: " + root.contrast-text;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.text;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.contrast-track-box.x;
        y: root.contrast-track-box.y;
        width: root.contrast-track-box.width;
        height: root.contrast-track-box.height;
        border-radius: 2px;
        background: Tokens.elevated;
    }

    Rectangle {
        x: root.contrast-thumb-box.x;
        y: root.contrast-thumb-box.y;
        width: root.contrast-thumb-box.width;
        height: root.contrast-thumb-box.height;
        border-radius: root.contrast-thumb-box.width / 2;
        background: Tokens.content;
        border-width: 1px;
        border-color: #00000030;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
    }

    // 6. Slider 4: Saturation
    Text {
        x: root.saturation-label-box.x;
        y: root.saturation-label-box.y;
        width: root.saturation-label-box.width;
        height: root.saturation-label-box.height;
        text: "Saturation: " + root.saturation-text;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.text;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.saturation-track-box.x;
        y: root.saturation-track-box.y;
        width: root.saturation-track-box.width;
        height: root.saturation-track-box.height;
        border-radius: 2px;
        background: Tokens.elevated;
    }

    Rectangle {
        x: root.saturation-thumb-box.x;
        y: root.saturation-thumb-box.y;
        width: root.saturation-thumb-box.width;
        height: root.saturation-thumb-box.height;
        border-radius: root.saturation-thumb-box.width / 2;
        background: Tokens.content;
        border-width: 1px;
        border-color: #00000030;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
    }

    // 7. Slider 5: Warmth
    Text {
        x: root.warmth-label-box.x;
        y: root.warmth-label-box.y;
        width: root.warmth-label-box.width;
        height: root.warmth-label-box.height;
        text: "Color Warmth: " + root.warmth-text;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.text;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.warmth-track-box.x;
        y: root.warmth-track-box.y;
        width: root.warmth-track-box.width;
        height: root.warmth-track-box.height;
        border-radius: 2px;
        background: Tokens.elevated;
    }

    Rectangle {
        x: root.warmth-thumb-box.x;
        y: root.warmth-thumb-box.y;
        width: root.warmth-thumb-box.width;
        height: root.warmth-thumb-box.height;
        border-radius: root.warmth-thumb-box.width / 2;
        background: Tokens.content;
        border-width: 1px;
        border-color: #00000030;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
    }

    // 8. Slider 6: Vignette
    Text {
        x: root.vignette-label-box.x;
        y: root.vignette-label-box.y;
        width: root.vignette-label-box.width;
        height: root.vignette-label-box.height;
        text: "Vignette: " + root.vignette-text;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.text;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.vignette-track-box.x;
        y: root.vignette-track-box.y;
        width: root.vignette-track-box.width;
        height: root.vignette-track-box.height;
        border-radius: 2px;
        background: Tokens.elevated;
    }

    Rectangle {
        x: root.vignette-thumb-box.x;
        y: root.vignette-thumb-box.y;
        width: root.vignette-thumb-box.width;
        height: root.vignette-thumb-box.height;
        border-radius: root.vignette-thumb-box.width / 2;
        background: Tokens.content;
        border-width: 1px;
        border-color: #00000030;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
    }

    // 9. Footer
    Hairline {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.hairline-bottom;
    }

    // Reset button
    Rectangle {
        x: root.reset-box.x;
        y: root.reset-box.y;
        width: root.reset-box.width;
        height: root.reset-box.height;
        border-radius: Tokens.radius-small;
        background: Tokens.quiet;

        Text {
            text: "Reset";
            font-size: 11px;
            color: Tokens.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.reset-defaults-chosen(); }
        }
    }

    // Helper text
    Text {
        x: root.helper-box.x;
        y: root.helper-box.y;
        width: root.helper-box.width;
        height: root.helper-box.height;
        text: "Drag sliders · Enter to save";
        font-size: 11px;
        color: Tokens.text-muted;
        vertical-alignment: center;
    }

    // Cancel button
    Rectangle {
        x: root.cancel-box.x;
        y: root.cancel-box.y;
        width: root.cancel-box.width;
        height: root.cancel-box.height;
        border-radius: Tokens.radius-control;
        background: Tokens.quiet;

        Text {
            text: "Cancel";
            font-size: 12px;
            color: Tokens.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => { root.cancel-chosen(); }
        }
    }

    // Run button
    Rectangle {
        x: root.run-box.x;
        y: root.run-box.y;
        width: root.run-box.width;
        height: root.run-box.height;
        border-radius: Tokens.radius-control;
        background: root.run-enabled ? Tokens.accent : Tokens.quiet;

        Text {
            text: root.run-label;
            font-size: 12px;
            font-weight: 600;
            color: root.run-enabled ? Tokens.content : Tokens.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            clicked => {
                if root.run-enabled {
                    root.run-chosen();
                }
            }
        }
    }
}
