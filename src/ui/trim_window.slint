// The card a video is trimmed in.
//
// The skeleton is the shell's (shell.slint); the body is the video
// pattern the reference lays out: the frame at the playhead on the
// picture's own dark, a line of small words saying what to do and what
// is held, the range strip with its two orange caps, the moments said in
// the face where every digit takes the same room, and the bare transport
// glyphs. The card only draws: the pressing, dragging and stepping are
// read by the window itself, which holds the same geometry the card was
// given — the way the wheel works.

import { Tokens } from "tokens.slint";
import { Panel } from "tokens.slint";
import { CardHeader, Hairline, IconButton, TimelineRange, CardFooter, PillButton } from "shell.slint";

export component TrimCard inherits Window {
    // The size of the card, held here so the renderer reads what the
    // window really is: the system tells us the client size, and the
    // renderer draws exactly what these two say.
    in property <length> card-width: 420px;
    in property <length> card-height: 544px;

    // What the card says.
    in property <string> file-name;
    in property <string> detail;
    in property <float> ui-scale: 1.0;

    // The frame at the playhead, and whether there is one.
    in property <image> frame;
    in property <bool> has-frame;

    // Where everything is.
    in property <Panel> header-box;
    in property <Panel> detail-box;
    in property <Panel> hairline-top;
    in property <Panel> hairline-bottom;
    in property <Panel> preview-box;
    in property <Panel> caption-box;
    in property <Panel> timeline-box;
    in property <Panel> times-box;
    in property <Panel> step-back-box;
    in property <Panel> step-forward-box;
    in property <Panel> transport-box;
    in property <Panel> helper-box;
    in property <Panel> cancel-box;
    in property <Panel> run-box;

    // Where the video begins and ends, and where the playhead stands,
    // each a share of the whole (0 to 1).
    in property <float> start-fraction: 0;
    in property <float> end-fraction: 1;
    in property <float> playhead-fraction: 0;

    // What the words say.
    in property <string> selected-text;
    in property <string> start-text;
    in property <string> end-text;
    in property <string> playhead-text;
    // The video's own moments, for the strip to wear.
    in property <image> filmstrip;

    // 0 no cap, 1 the start cap, 2 the end cap.
    in property <int> handle-focus;
    // 0 nothing, 1 cancel, 2 run.
    in property <int> button-focus;

    // The split card: the cuts the strip stands on, what the rows say,
    // and where every split row is. A trim card leaves these all quiet.
    in property <bool> split-mode: false;
    in property <string> points-text: "";
    in property <string> parts-text: "2";
    in property <string> run-label: "Trim";
    // Where the cuts stand, shares of the whole, said to the strip.
    in property <[float]> markers;
    in property <Panel> points-box;
    in property <Panel> add-split-box;
    in property <Panel> equal-label-box;
    in property <Panel> stepper-box;
    in property <Panel> step-up-box;
    in property <Panel> step-down-box;
    in property <Panel> set-box;
    // 0 nothing, 1 add-split, 2 set.
    in property <int> pill-focus: 0;
    // Whether there is anything to do when go is said: a split with no
    // cut yet has nothing, and its go button is retired.
    in property <bool> run-enabled: true;

    callback run-chosen();
    callback cancel-chosen();
    // Step the handle the keyboard is on, back or forward.
    callback step-backward();
    callback step-forward();
    // The split card's own rows: put a cut at the playhead, make the
    // equal parts live, and turn the count.
    callback add-split-chosen();
    callback set-equal-chosen();
    callback stepper-up();
    callback stepper-down();

    width: root.card-width;
    height: root.card-height;

    Rectangle {
        background: Tokens.window-bg;
    }

    CardHeader {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        file-name: root.file-name;
        detail: root.detail;
        ui-scale: root.ui-scale;
        header-box: root.header-box;
        detail-box: root.detail-box;
    }
    Hairline {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.hairline-top;
    }

    // The frame at the playhead, on the picture's own dark, with the
    // margins the reference gives its stages. (The picture is fitted
    // inside, so the stage needs no clipping — and the software renderer
    // has been known to drop what follows a clipped subtree.)
    Rectangle {
        x: root.preview-box.x; y: root.preview-box.y;
        width: root.preview-box.width; height: root.preview-box.height;
        border-radius: Tokens.radius-preview;
        background: Tokens.preview-black;

        if root.has-frame: Image {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            source: root.frame;
            image-fit: contain;
        }
    }

    // The line of small words above the strip: what to do, and what is
    // held. A split card says its own points row instead.
    Text {
        visible: !root.split-mode;
        x: root.caption-box.x; y: root.caption-box.y;
        width: root.caption-box.width / 2; height: root.caption-box.height;
        text: "Drag the ends to trim";
        color: Tokens.text-muted;
        font-size: root.ui-scale * 13px;
        font-family: "Segoe UI";
        vertical-alignment: center;
    }
    Text {
        visible: !root.split-mode;
        x: root.caption-box.x + root.caption-box.width / 2;
        y: root.caption-box.y;
        width: root.caption-box.width / 2; height: root.caption-box.height;
        text: root.selected-text;
        color: Tokens.text-muted;
        font-size: root.ui-scale * 13px;
        font-family: Tokens.font-mono;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    // The points row: how many cuts stand, and the pill that puts one
    // where the playhead is.
    Text {
        visible: root.split-mode;
        x: root.points-box.x; y: root.points-box.y;
        width: root.points-box.width; height: root.points-box.height;
        text: root.points-text;
        color: Tokens.text;
        font-size: root.ui-scale * 13px;
        font-family: "Segoe UI";
        vertical-alignment: center;
        overflow: elide;
    }
    PillButton {
        visible: root.split-mode;
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.add-split-box;
        label: "Add Split";
        focused: root.pill-focus == 1;
        ui-scale: root.ui-scale;
        clicked => { root.add-split-chosen(); }
    }

    // The range: the video's own moments with the two orange caps and
    // the playhead standing on the moment. A split card wears the same
    // strip without the range: the cuts stand on it as markers.
    TimelineRange {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.timeline-box;
        filmstrip: root.filmstrip;
        start-fraction: root.start-fraction;
        end-fraction: root.end-fraction;
        playhead-fraction: root.playhead-fraction;
        handle-focus: root.handle-focus;
        has-range: !root.split-mode;
        markers: root.markers;
    }
    // Where the video begins and ends, said in the face where every
    // digit takes the same room.
    Text {
        visible: !root.split-mode;
        x: root.times-box.x; y: root.times-box.y;
        width: root.times-box.width / 2; height: root.times-box.height;
        text: "Start " + root.start-text;
        color: Tokens.text;
        font-size: root.ui-scale * 13px;
        font-family: Tokens.font-mono;
        vertical-alignment: center;
    }
    Text {
        visible: !root.split-mode;
        x: root.times-box.x + root.times-box.width / 2;
        y: root.times-box.y;
        width: root.times-box.width / 2; height: root.times-box.height;
        text: "End " + root.end-text;
        color: Tokens.text;
        font-size: root.ui-scale * 13px;
        font-family: Tokens.font-mono;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    // The transport: bare glyphs to step the handle, and where the
    // playhead stands against the whole.
    IconButton {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.step-back-box;
        glyph: "M 8 5 L 8 19 M 18 6 L 10 12 L 18 18";
        ui-scale: root.ui-scale;
        clicked => { root.step-backward(); }
    }
    IconButton {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.step-forward-box;
        glyph: "M 16 5 L 16 19 M 6 6 L 14 12 L 6 18";
        ui-scale: root.ui-scale;
        clicked => { root.step-forward(); }
    }
    Text {
        x: root.transport-box.x; y: root.transport-box.y;
        width: root.transport-box.width; height: root.transport-box.height;
        text: root.playhead-text;
        color: Tokens.text;
        font-size: root.ui-scale * 13px;
        font-family: Tokens.font-mono;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    // The equal row: what a split card carries — the count of its equal
    // parts, a stepper to turn it, and the pill that says where the cuts
    // stand. A trim card says nothing here.
    Text {
        visible: root.split-mode;
        x: root.equal-label-box.x; y: root.equal-label-box.y;
        width: root.equal-label-box.width; height: root.equal-label-box.height;
        text: "Equal clips";
        color: Tokens.text;
        font-size: root.ui-scale * 13px;
        font-family: "Segoe UI";
        vertical-alignment: center;
    }
    // The well the number is said in: white with a thin border, as every
    // field on the card is.
    Rectangle {
        visible: root.split-mode;
        x: root.stepper-box.x; y: root.stepper-box.y;
        width: root.stepper-box.width; height: root.stepper-box.height;
        border-radius: Tokens.radius-control;
        background: Tokens.content;
        border-width: 1px;
        border-color: Tokens.field-border;

        Text {
            x: 4px; width: parent.width - 8px;
            height: parent.height;
            text: root.parts-text;
            color: Tokens.text;
            font-size: root.ui-scale * 13px;
            font-family: Tokens.font-mono;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    // The two little wings of the stepper: the upper half turns the
    // count up, the lower half turns it down.
    Rectangle {
        visible: root.split-mode;
        x: root.step-up-box.x; y: root.step-up-box.y;
        width: root.step-up-box.width;
        height: root.step-up-box.height;
        Path {
            commands: "M 9 15 L 12 12 L 15 15";
            viewbox-width: 24;
            viewbox-height: 24;
            width: root.ui-scale * 12px;
            height: root.ui-scale * 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 1px;
            fill: transparent;
            stroke: Tokens.transport;
            stroke-width: 1.8px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        stepper-up-touch := TouchArea {
            clicked => { root.stepper-up(); }
        }
    }
    Rectangle {
        visible: root.split-mode;
        x: root.step-down-box.x; y: root.step-down-box.y;
        width: root.step-down-box.width;
        height: root.step-down-box.height;
        Path {
            commands: "M 9 13 L 12 16 L 15 13";
            viewbox-width: 24;
            viewbox-height: 24;
            width: root.ui-scale * 12px;
            height: root.ui-scale * 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 1px;
            fill: transparent;
            stroke: Tokens.transport;
            stroke-width: 1.8px;
            stroke-line-cap: round;
            stroke-line-join: round;
        }
        stepper-down-touch := TouchArea {
            clicked => { root.stepper-down(); }
        }
    }
    PillButton {
        visible: root.split-mode;
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.set-box;
        label: "Set";
        focused: root.pill-focus == 2;
        ui-scale: root.ui-scale;
        clicked => { root.set-equal-chosen(); }
    }

    Hairline {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        box: root.hairline-bottom;
    }

    CardFooter {
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
        ui-scale: root.ui-scale;
        run-label: root.run-label;
        has-cancel: false;
        run-enabled: root.run-enabled;
        helper-box: root.helper-box;
        cancel-box: root.cancel-box;
        run-box: root.run-box;
        button-focus: root.button-focus;
        run-chosen => { root.run-chosen(); }
        cancel-chosen => { root.cancel-chosen(); }
    }
}
