// The card a video is trimmed in.
//
// The skeleton is the shell's (shell.slint); the body is the video
// pattern the reference lays out: the frame at the playhead on the
// picture's own dark, a line of small words saying what to do and what
// is held, the range strip with its two orange caps, the moments said in
// the face where every digit takes the same room, and the bare transport
// glyphs. The card only draws: the pressing, dragging and stepping are
// read by the window itself, which holds the same geometry the card was
// given — the way the wheel works.

import { Tokens } from "tokens.slint";
import { Panel } from "tokens.slint";
import { CardHeader, Hairline, IconButton, TimelineRange, CardFooter } from "shell.slint";

export component TrimCard inherits Window {
    // The size of the card, held here so the renderer reads what the
    // window really is: the system tells us the client size, and the
    // renderer draws exactly what these two say.
    in property <length> card-width: 420px;
    in property <length> card-height: 544px;

    // What the card says.
    in property <string> file-name;
    in property <string> detail;
    in property <float> ui-scale: 1.0;

    // The frame at the playhead, and whether there is one.
    in property <image> frame;
    in property <bool> has-frame;

    // Where everything is.
    in property <Panel> header-box;
    in property <Panel> detail-box;
    in property <Panel> hairline-top;
    in property <Panel> hairline-bottom;
    in property <Panel> preview-box;
    in property <Panel> caption-box;
    in property <Panel> timeline-box;
    in property <Panel> times-box;
    in property <Panel> step-back-box;
    in property <Panel> step-forward-box;
    in property <Panel> transport-box;
    in property <Panel> helper-box;
    in property <Panel> cancel-box;
    in property <Panel> run-box;

    // Where the video begins and ends, and where the playhead stands,
    // each a share of the whole (0 to 1).
    in property <float> start-fraction: 0;
    in property <float> end-fraction: 1;
    in property <float> playhead-fraction: 0;

    // What the words say.
    in property <string> selected-text;
    in property <string> start-text;
    in property <string> end-text;
    in property <string> playhead-text;

    // 0 no cap, 1 the start cap, 2 the end cap.
    in property <int> handle-focus;
    // 0 nothing, 1 cancel, 2 run.
    in property <int> button-focus;

    callback run-chosen();
    callback cancel-chosen();
    // Step the handle the keyboard is on, back or forward.
    callback step-backward();
    callback step-forward();

    width: root.card-width;
    height: root.card-height;

    Rectangle {
        background: Tokens.window-bg;
    }

    CardHeader {
        file-name: root.file-name;
        detail: root.detail;
        ui-scale: root.ui-scale;
        header-box: root.header-box;
        detail-box: root.detail-box;
    }
    Hairline { box: root.hairline-top; }

    // The frame at the playhead, on the picture's own dark, with the
    // margins the reference gives its stages. (The picture is fitted
    // inside, so the stage needs no clipping — and the software renderer
    // has been known to drop what follows a clipped subtree.)
    Rectangle {
        x: root.preview-box.x; y: root.preview-box.y;
        width: root.preview-box.width; height: root.preview-box.height;
        border-radius: Tokens.radius-preview;
        background: Tokens.preview-black;

        if root.has-frame: Image {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            source: root.frame;
            image-fit: contain;
        }
    }

    // The line of small words above the strip: what to do, and what is
    // held.
    Text {
        x: root.caption-box.x; y: root.caption-box.y;
        width: root.caption-box.width / 2; height: root.caption-box.height;
        text: "Drag the ends to trim";
        color: Tokens.text-muted;
        font-size: root.ui-scale * 13px;
        font-family: "Segoe UI";
        vertical-alignment: center;
    }
    Text {
        x: root.caption-box.x + root.caption-box.width / 2;
        y: root.caption-box.y;
        width: root.caption-box.width / 2; height: root.caption-box.height;
        text: root.selected-text;
        color: Tokens.text-muted;
        font-size: root.ui-scale * 13px;
        font-family: Tokens.font-mono;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    // The range: the strip with the two orange caps and the playhead.
    Rectangle {
        x: root.timeline-box.x; y: root.timeline-box.y;
        width: root.timeline-box.width; height: root.timeline-box.height;
        background: #00ff00;
    }
    Hairline {
        box: root.hairline-bottom;
        x: 0; y: 0;
        width: root.card-width;
        height: root.card-height;
    }
    // Where the video begins and ends, said in the face where every
    // digit takes the same room.
    Text {
        x: root.times-box.x; y: root.times-box.y;
        width: root.times-box.width / 2; height: root.times-box.height;
        text: "Start " + root.start-text;
        color: Tokens.text;
        font-size: root.ui-scale * 13px;
        font-family: Tokens.font-mono;
        vertical-alignment: center;
    }
    Text {
        x: root.times-box.x + root.times-box.width / 2;
        y: root.times-box.y;
        width: root.times-box.width / 2; height: root.times-box.height;
        text: "End " + root.end-text;
        color: Tokens.text;
        font-size: root.ui-scale * 13px;
        font-family: Tokens.font-mono;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    // The transport: bare glyphs to step the handle, and where the
    // playhead stands against the whole.
    IconButton {
        box: root.step-back-box;
        glyph: "M 8 5 L 8 19 M 18 6 L 10 12 L 18 18";
        ui-scale: root.ui-scale;
        clicked => { root.step-backward(); }
    }
    IconButton {
        box: root.step-forward-box;
        glyph: "M 16 5 L 16 19 M 6 6 L 14 12 L 6 18";
        ui-scale: root.ui-scale;
        clicked => { root.step-forward(); }
    }
    Text {
        x: root.transport-box.x; y: root.transport-box.y;
        width: root.transport-box.width; height: root.transport-box.height;
        text: root.playhead-text;
        color: Tokens.text;
        font-size: root.ui-scale * 13px;
        font-family: Tokens.font-mono;
        vertical-alignment: center;
        horizontal-alignment: right;
    }

    Hairline { box: root.hairline-bottom; }

    CardFooter {
        ui-scale: root.ui-scale;
        run-label: "Trim";
        has-cancel: false;
        helper-box: root.helper-box;
        cancel-box: root.cancel-box;
        run-box: root.run-box;
        button-focus: root.button-focus;
        run-chosen => { root.run-chosen(); }
        cancel-chosen => { root.cancel-chosen(); }
    }
}
